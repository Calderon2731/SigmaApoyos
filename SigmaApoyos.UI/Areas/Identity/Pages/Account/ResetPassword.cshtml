@page
@model SigmaApoyos.UI.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Nueva contraseña";
}

<div class="identity-recovery-shell">
    <section class="surface-card identity-recovery-card">
        <div class="identity-recovery-header">
            <span class="identity-recovery-icon" aria-hidden="true">CL</span>
            <span class="page-eyebrow">Seguridad de la cuenta</span>
            <h1>Crea una nueva contraseña</h1>
            <p>Completa los datos para recuperar el acceso a Sigma Apoyos.</p>
        </div>

        <div class="card-body-comfort">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <input asp-for="Input.Code" type="hidden" />

                <div class="mb-3">
                    <label class="form-label" asp-for="Input.Email"></label>
                    <input class="form-control" asp-for="Input.Email" autocomplete="username" placeholder="nombre@correo.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Input.Password"></label>
                    <input class="form-control" asp-for="Input.Password" autocomplete="new-password" placeholder="Nueva contraseña" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label" asp-for="Input.ConfirmPassword"></label>
                    <input class="form-control" asp-for="Input.ConfirmPassword" autocomplete="new-password" placeholder="Confirma la contraseña" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Guardar nueva contraseña</button>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
