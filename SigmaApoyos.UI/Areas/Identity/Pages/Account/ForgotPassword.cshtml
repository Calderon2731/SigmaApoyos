@page
@model SigmaApoyos.UI.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="identity-recovery-shell">
    <section class="surface-card identity-recovery-card">
        <div class="identity-recovery-header">
            <span class="identity-recovery-icon" aria-hidden="true">RC</span>
            <span class="page-eyebrow">Seguridad de la cuenta</span>
            <h1>Recuperar contraseña</h1>
            <p>Ingresa el correo asociado a tu usuario y te enviaremos un enlace seguro.</p>
        </div>

        <div class="card-body-comfort">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="mb-4">
                    <label class="form-label" asp-for="Input.Email"></label>
                    <input class="form-control" asp-for="Input.Email" autocomplete="email" placeholder="nombre@correo.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Enviar enlace de recuperación</button>
            </form>

            <div class="identity-recovery-footer">
                <a asp-page="./Login">Volver a iniciar sesión</a>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
