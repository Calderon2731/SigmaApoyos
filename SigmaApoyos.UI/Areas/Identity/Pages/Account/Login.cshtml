@page
@model SigmaApoyos.UI.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="identity-login-shell">
    <div class="identity-login-card">
        <aside class="identity-login-aside">
            <span class="identity-login-mark" aria-hidden="true">Σ</span>
            <span class="identity-login-kicker">Liceo de Calle Fallas</span>
            <h1>Bienvenido a Sigma Apoyos</h1>
            <p>Ingresa para gestionar expedientes, documentos y adecuaciones estudiantiles de manera segura.</p>
           
        </aside>

        <section class="identity-login-form-panel">
            <div class="identity-login-heading">
                <span class="page-eyebrow">Mi cuenta</span>
                <h2>Iniciar sesión</h2>
                <p>Utiliza el correo y la contraseña asociados a tu usuario.</p>
            </div>

            <form id="account" method="post" asp-route-returnUrl="@Model.ReturnUrl">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Input.Email"></label>
                    <input class="form-control" asp-for="Input.Email" autocomplete="username" placeholder="nombre@correo.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Input.Password"></label>
                    <input class="form-control" asp-for="Input.Password" autocomplete="current-password" placeholder="Ingresa tu contraseña" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="identity-login-options">
                    <label class="form-check-label d-flex align-items-center gap-2" asp-for="Input.RememberMe">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        @Html.DisplayNameFor(model => model.Input.RememberMe)
                    </label>
                    <a asp-page="./ForgotPassword">¿Olvidaste tu contraseña?</a>
                </div>

                <button id="login-submit" type="submit" class="btn btn-primary w-100">Ingresar al sistema</button>
            </form>

            <p class="identity-login-help mb-0">
                Si no tienes acceso, solicita una cuenta al coordinador académico.
            </p>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
