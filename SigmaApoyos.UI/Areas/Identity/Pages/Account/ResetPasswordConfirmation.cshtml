@page
@model SigmaApoyos.UI.Areas.Identity.Pages.Account.ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Contraseña actualizada";
}

<div class="identity-recovery-shell">
    <section class="surface-card identity-recovery-card identity-recovery-result">
        <div class="card-body-comfort">
            <span class="identity-recovery-icon" aria-hidden="true">OK</span>
            <span class="page-eyebrow">Proceso completado</span>
            <h1>Contraseña actualizada</h1>
            <p>La contraseña se cambió correctamente. Ya puedes ingresar nuevamente a Sigma Apoyos.</p>
            <a class="btn btn-primary" asp-page="./Login">Iniciar sesión</a>
        </div>
    </section>
</div>
