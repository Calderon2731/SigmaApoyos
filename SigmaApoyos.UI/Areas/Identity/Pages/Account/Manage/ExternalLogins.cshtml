@page
@model ExternalLoginsModel
@{
    ViewData["Title"] = "Accesos externos";
    ViewData["ActivePage"] = ManageNavPages.ExternalLogins;
}

<section class="account-section">
    <header class="account-section-header">
        <span class="account-section-icon" aria-hidden="true">EX</span>
        <div>
            <span class="page-eyebrow">Métodos de acceso</span>
            <h2>Accesos externos</h2>
            <p>Administra las cuentas externas asociadas a tu usuario.</p>
        </div>
    </header>

    <partial name="_StatusMessage" for="StatusMessage" />

    @if (Model.CurrentLogins?.Count > 0)
    {
        <div class="account-option-list mb-4">
            @foreach (var login in Model.CurrentLogins)
            {
                <div class="account-option-card">
                    <div>
                        <h3 id="@($"login-provider-{login.LoginProvider}")">@login.ProviderDisplayName</h3>
                        <p>Servicio externo vinculado actualmente.</p>
                    </div>
                    @if (Model.ShowRemoveButton)
                    {
                        <form id="@($"remove-login-{login.LoginProvider}")" asp-page-handler="RemoveLogin" method="post">
                            <input asp-for="@login.LoginProvider" name="LoginProvider" type="hidden" />
                            <input asp-for="@login.ProviderKey" name="ProviderKey" type="hidden" />
                            <button type="submit" class="btn btn-outline-danger" title="Quitar el acceso mediante @login.ProviderDisplayName">Quitar acceso</button>
                        </form>
                    }
                </div>
            }
        </div>
    }

    @if (Model.OtherLogins?.Count > 0)
    {
        <div class="account-subsection">
            <h3>Agregar otro servicio</h3>
            <p>Selecciona el proveedor que deseas vincular.</p>
            <form id="link-login-form" asp-page-handler="LinkLogin" method="post">
                <div class="account-actions">
                    @foreach (var provider in Model.OtherLogins)
                    {
                        <button id="@($"link-login-button-{provider.Name}")" type="submit" class="btn btn-outline-primary" name="provider" value="@provider.Name" title="Vincular la cuenta de @provider.DisplayName">@provider.DisplayName</button>
                    }
                </div>
            </form>
        </div>
    }
</section>
