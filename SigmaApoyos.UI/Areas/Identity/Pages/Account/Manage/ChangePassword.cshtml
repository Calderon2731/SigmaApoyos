@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Cambiar contraseña";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<section class="account-section">
    <header class="account-section-header">
        <span class="account-section-icon" aria-hidden="true">CL</span>
        <div>
            <span class="page-eyebrow">Seguridad</span>
            <h2>Cambiar contraseña</h2>
            <p>Usa una contraseña segura que no utilices en otros servicios.</p>
        </div>
    </header>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="change-password-form" method="post" class="account-form">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="form-floating mb-3">
            <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Contraseña actual" />
            <label asp-for="Input.OldPassword">Contraseña actual</label>
            <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
        </div>
        <div class="form-floating mb-3">
            <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Nueva contraseña" />
            <label asp-for="Input.NewPassword">Nueva contraseña</label>
            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
        </div>
        <div class="form-floating mb-3">
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirmar contraseña" />
            <label asp-for="Input.ConfirmPassword">Confirmar nueva contraseña</label>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Actualizar contraseña</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
