@page
@model IndexModel
@{
    ViewData["Title"] = "Perfil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<section class="account-section">
    <header class="account-section-header">
        <span class="account-section-icon" aria-hidden="true">PR</span>
        <div>
            <span class="page-eyebrow">Información personal</span>
            <h2>Perfil</h2>
            <p>Consulta tu usuario y mantén actualizado tu número de teléfono.</p>
        </div>
    </header>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="profile-form" method="post" class="account-form">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="form-floating mb-3">
            <input asp-for="Username" class="form-control" placeholder="Usuario" disabled />
            <label asp-for="Username">Usuario</label>
        </div>
        <div class="form-floating mb-3">
            <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Número de teléfono" />
            <label asp-for="Input.PhoneNumber">Número de teléfono</label>
            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
        </div>
        <button id="update-profile-button" type="submit" class="btn btn-primary">Guardar cambios</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
