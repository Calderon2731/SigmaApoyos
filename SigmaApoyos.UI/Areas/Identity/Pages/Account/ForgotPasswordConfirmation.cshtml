@page
@model SigmaApoyos.UI.Areas.Identity.Pages.Account.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Revisa tu correo";
}

<div class="identity-recovery-shell">
    <section class="surface-card identity-recovery-card identity-recovery-result">
        <div class="card-body-comfort">
            <span class="identity-recovery-icon" aria-hidden="true">OK</span>
            <span class="page-eyebrow">Solicitud recibida</span>
            <h1>Revisa tu correo</h1>
            <p>Si existe una cuenta asociada al correo indicado, recibirás un enlace para restablecer la contraseña.</p>
            <p class="form-hint">Revisa también la carpeta de correo no deseado.</p>
            <a class="btn btn-primary" asp-page="./Login">Volver a iniciar sesión</a>
        </div>
    </section>
</div>
