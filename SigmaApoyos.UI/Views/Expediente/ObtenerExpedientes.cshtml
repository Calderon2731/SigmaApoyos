@using Microsoft.AspNetCore.Mvc.Rendering
@using SigmaApoyos.Application.DTOs.Comunes
@using SigmaApoyos.Application.DTOs.Expedientes
@model ResultadoPaginadoDto<ExpedienteDto>

@{
    ViewData["Title"] = "Expedientes";
    var filtro = ViewBag.Filtro as FiltroExpedienteDto ?? new FiltroExpedienteDto();
    const int registrosPorPagina = 10;
    int primerRegistro = Model.TotalRegistros == 0 ? 0 : ((Model.PaginaActual - 1) * registrosPorPagina) + 1;
    int ultimoRegistro = Math.Min(Model.PaginaActual * registrosPorPagina, Model.TotalRegistros);
    int paginaInicial = Math.Max(1, Model.PaginaActual - 2);
    int paginaFinal = Math.Min(Model.TotalPaginas, Model.PaginaActual + 2);
}

<div class="page-header">
    <div>
        <span class="page-eyebrow">Gestión estudiantil</span>
        <h1 class="page-title">Expedientes</h1>
        <p class="page-subtitle">Consulta y administra los expedientes de adecuación.</p>
    </div>
    @if (User.PuedeCrearExpedientes())
    {
        <a class="btn btn-primary" asp-controller="Expediente" asp-action="CrearExpediente">+ Nuevo expediente</a>
    }
</div>

<form class="search-panel" asp-action="ObtenerExpedientes" method="get">
    <div class="row g-3 align-items-end">
        <div class="col-lg-4">
            <label class="form-label" for="identificacion">Identificación</label>
            <div class="search-input">
                <span class="search-glyph" aria-hidden="true">⌕</span>
                <input class="form-control" id="identificacion" type="text" name="identificacion"
                       value="@filtro.Identificacion" placeholder="Identificación del estudiante" />
            </div>
        </div>
        <div class="col-md-4 col-lg-3">
            <label class="form-label" for="idEstado">Estado</label>
            <select class="form-select" id="idEstado" name="idEstado"
                    asp-items="@(ViewBag.Estados as SelectList)">
                <option value="">Todos los estados</option>
            </select>
        </div>
        <div class="col-md-4 col-lg-3">
            <label class="form-label" for="idTipoAdecuacion">Tipo de adecuación</label>
            <select class="form-select" id="idTipoAdecuacion" name="idTipoAdecuacion"
                    asp-items="@(ViewBag.TiposAdecuacion as SelectList)">
                <option value="">Todos los tipos</option>
            </select>
        </div>
        <div class="col-md-4 col-lg-2">
            <div class="d-grid gap-2 d-sm-flex d-lg-grid">
                <button class="btn btn-outline-primary flex-fill" type="submit">Filtrar</button>
                <a class="btn btn-outline-secondary flex-fill" asp-action="ObtenerExpedientes">Limpiar</a>
            </div>
        </div>
    </div>
</form>

<div class="surface-card overflow-hidden">
    @if (Model.Registros.Any())
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Identificación</th>
                        <th>Estudiante</th>
                        <th>Nacimiento</th>
                        <th>Encargado</th>
                        <th>Tipo de adecuación</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var expediente in Model.Registros)
                    {
                        <tr>
                            <td><strong>@expediente.IdentificacionEstudiante</strong></td>
                            <td>
                                <strong class="d-block text-nowrap">@expediente.Nombre @expediente.PrimerApellido</strong>
                                <small class="text-muted">@expediente.SegundoApellido</small>
                            </td>
                            <td class="text-nowrap">@expediente.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="d-block text-nowrap">@expediente.NombreEncargado</span>
                                <small class="text-muted">@expediente.TelefonoEncargado</small>
                            </td>
                            <td>
                                @if (expediente.IdTipoAdecuacion == 1)
                                {
                                    <span class="type-badge">Significativa</span>
                                }
                                else if (expediente.IdTipoAdecuacion == 2)
                                {
                                    <span class="type-badge">No significativa</span>
                                }
                                else if (expediente.IdTipoAdecuacion == 3)
                                {
                                    <span class="type-badge">De acceso</span>
                                }
                                else
                                {
                                    <span class="status-badge status-neutral">No definida</span>
                                }
                            </td>
                            <td>
                                <span class="status-badge @(expediente.IdEstado == 2 ? "status-active" : "status-inactive")">
                                    @(expediente.IdEstado == 2 ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td>
                                <div class="table-actions justify-content-end">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="DetallesExpediente"
                                       asp-route-identificacion="@expediente.IdentificacionEstudiante">Ver</a>
                                    @if (User.PuedeModificarExpedientes())
                                    {
                                        <a class="btn btn-sm btn-outline-secondary" asp-action="EditarExpediente"
                                           asp-route-identificacion="@expediente.IdentificacionEstudiante">Editar</a>
                                    }
                                    @if (User.PuedeEliminarExpedientes())
                                    {
                                        <a class="btn btn-sm btn-outline-danger" asp-action="EliminarExpediente"
                                           asp-route-identificacion="@expediente.IdentificacionEstudiante">Eliminar</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">EX</div>
            <h2>No hay expedientes para mostrar</h2>
            <p class="mb-0">Prueba con otros filtros o registra el primer expediente.</p>
        </div>
    }
</div>

@if (Model.TotalRegistros > 0)
{
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mt-3">
        <p class="text-muted mb-0">
            Mostrando @primerRegistro-@ultimoRegistro de @Model.TotalRegistros expedientes
        </p>

        @if (Model.TotalPaginas > 1)
        {
            <nav aria-label="Paginación de expedientes">
                <ul class="pagination mb-0">
                    <li class="page-item @(!Model.TienePaginaAnterior ? "disabled" : string.Empty)">
                        <a class="page-link" asp-action="ObtenerExpedientes"
                           asp-route-identificacion="@filtro.Identificacion"
                           asp-route-idEstado="@filtro.IdEstado"
                           asp-route-idTipoAdecuacion="@filtro.IdTipoAdecuacion"
                           asp-route-pagina="@(Model.PaginaActual - 1)">Anterior</a>
                    </li>

                    @for (int pagina = paginaInicial; pagina <= paginaFinal; pagina++)
                    {
                        <li class="page-item @(pagina == Model.PaginaActual ? "active" : string.Empty)">
                            <a class="page-link" asp-action="ObtenerExpedientes"
                               asp-route-identificacion="@filtro.Identificacion"
                               asp-route-idEstado="@filtro.IdEstado"
                               asp-route-idTipoAdecuacion="@filtro.IdTipoAdecuacion"
                               asp-route-pagina="@pagina">@pagina</a>
                        </li>
                    }

                    <li class="page-item @(!Model.TienePaginaSiguiente ? "disabled" : string.Empty)">
                        <a class="page-link" asp-action="ObtenerExpedientes"
                           asp-route-identificacion="@filtro.Identificacion"
                           asp-route-idEstado="@filtro.IdEstado"
                           asp-route-idTipoAdecuacion="@filtro.IdTipoAdecuacion"
                           asp-route-pagina="@(Model.PaginaActual + 1)">Siguiente</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
