@model SigmaApoyos.Application.DTOs.Expedientes.UpdateExpedienteDto

@{
    ViewData["Title"] = "Editar expediente";
}

<div class="page-header">
    <div>
        <span class="page-eyebrow">Actualización de datos</span>
        <h1 class="page-title">Editar expediente</h1>
        <p class="page-subtitle">Modifica la información registrada para este estudiante.</p>
    </div>
</div>

<form asp-action="EditarExpediente" method="post">
    <div class="surface-card">
        <div class="card-header-clean">
            <h2 class="h5 fw-bold mb-1">Información del estudiante</h2>
            <p class="form-hint mb-0">La identificación es el dato principal del expediente y no puede cambiarse.</p>
        </div>
        <div class="card-body-comfort">
            <div asp-validation-summary="ModelOnly"></div>
            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label" asp-for="IdentificacionEstudiante"></label>
                    <input class="form-control" asp-for="IdentificacionEstudiante" readonly />
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="Nombre"></label>
                    <input class="form-control" asp-for="Nombre" />
                    <span asp-validation-for="Nombre"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="PrimerApellido"></label>
                    <input class="form-control" asp-for="PrimerApellido" />
                    <span asp-validation-for="PrimerApellido"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="SegundoApellido"></label>
                    <input class="form-control" asp-for="SegundoApellido" />
                    <span asp-validation-for="SegundoApellido"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="FechaNacimiento"></label>
                    <input class="form-control" asp-for="FechaNacimiento" type="date" />
                    <span asp-validation-for="FechaNacimiento"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="NombreEncargado"></label>
                    <input class="form-control" asp-for="NombreEncargado" />
                    <span asp-validation-for="NombreEncargado"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="TelefonoEncargado"></label>
                    <input class="form-control" asp-for="TelefonoEncargado" />
                    <span asp-validation-for="TelefonoEncargado"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="IdTipoAdecuacion"></label>
                    <select class="form-select" asp-for="IdTipoAdecuacion">
                        <option value="1">Significativa</option>
                        <option value="2">No significativa</option>
                        <option value="3">De acceso</option>
                    </select>
                    <span asp-validation-for="IdTipoAdecuacion"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="IdEstado"></label>
                    <select class="form-select" asp-for="IdEstado">
                        <option value="1">Inactivo</option>
                        <option value="2">Activo</option>
                    </select>
                    <span asp-validation-for="IdEstado"></span>
                </div>
                <div class="col-12">
                    <label class="form-label" asp-for="Observaciones"></label>
                    <textarea class="form-control" asp-for="Observaciones"></textarea>
                    <span asp-validation-for="Observaciones"></span>
                </div>
                <div class="col-12 form-actions">
                    <button class="btn btn-primary" type="submit">Guardar cambios</button>
                    <a class="btn btn-outline-secondary" asp-action="ObtenerExpedientes">Cancelar</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
