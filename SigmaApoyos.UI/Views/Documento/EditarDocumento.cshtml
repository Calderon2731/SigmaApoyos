@model SigmaApoyos.Application.DTOs.Documentos.UpdateDocumentoDto

@{
    ViewData["Title"] = "Editar documento";
}

<div class="page-header">
    <div>
        <span class="page-eyebrow">Documento #@Model.IdDocumento</span>
        <h1 class="page-title">Editar documento</h1>
        <p class="page-subtitle">Actualiza los datos o reemplaza el archivo PDF actual.</p>
    </div>
</div>

<form asp-action="EditarDocumento" method="post" enctype="multipart/form-data">
    <div class="surface-card">
        <div class="card-header-clean">
            <h2 class="h5 fw-bold mb-1">Información del documento</h2>
            <p class="form-hint mb-0">Si no seleccionas otro PDF, se conservará el archivo existente.</p>
        </div>
        <div class="card-body-comfort">
            <div asp-validation-summary="ModelOnly"></div>
            <input asp-for="IdDocumento" type="hidden" />
            <input asp-for="RutaArchivo" type="hidden" />

            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label" asp-for="IdentificacionEstudiante"></label>
                    <input class="form-control" asp-for="IdentificacionEstudiante" />
                    <span asp-validation-for="IdentificacionEstudiante"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="TipoDocumentoId"></label>
                    <select class="form-select" asp-for="TipoDocumentoId" asp-items="ViewBag.TiposDocumento">
                        <option value="">Seleccione un tipo de documento</option>
                    </select>
                    <span asp-validation-for="TipoDocumentoId"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="Consecutivo"></label>
                    <input class="form-control" asp-for="Consecutivo" />
                    <span asp-validation-for="Consecutivo"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="IdEstado"></label>
                    <select class="form-select" asp-for="IdEstado" asp-items="ViewBag.Estados">
                        <option value="">Seleccione un estado</option>
                    </select>
                    <span asp-validation-for="IdEstado"></span>
                </div>
                <div class="col-12">
                    <label class="form-label" for="archivoPdf">Reemplazar archivo PDF</label>
                    <div class="alert alert-light border mb-2">
                        <span class="detail-label">Archivo actual</span>
                        <span class="detail-value">@Model.RutaArchivo</span>
                    </div>
                    <input class="form-control" type="file" id="archivoPdf" name="archivoPdf" accept=".pdf,application/pdf" />
                </div>
                <div class="col-12 form-actions">
                    <button class="btn btn-primary" type="submit">Guardar cambios</button>
                    <a class="btn btn-outline-secondary" asp-action="ObtenerDocumentos">Cancelar</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
