@using Microsoft.AspNetCore.Mvc.Rendering
@using SigmaApoyos.Application.DTOs.Comunes
@using SigmaApoyos.Application.DTOs.Documentos
@model ResultadoPaginadoDto<DocumentoDto>

@{
    ViewData["Title"] = "Documentos";
    var filtro = ViewBag.Filtro as FiltroDocumentoDto ?? new FiltroDocumentoDto();
    const int registrosPorPagina = 10;
    int primerRegistro = Model.TotalRegistros == 0 ? 0 : ((Model.PaginaActual - 1) * registrosPorPagina) + 1;
    int ultimoRegistro = Math.Min(Model.PaginaActual * registrosPorPagina, Model.TotalRegistros);
    int paginaInicial = Math.Max(1, Model.PaginaActual - 2);
    int paginaFinal = Math.Min(Model.TotalPaginas, Model.PaginaActual + 2);
}

<div class="page-header">
    <div>
        <span class="page-eyebrow">Archivo digital</span>
        <h1 class="page-title">Documentos</h1>
        <p class="page-subtitle">Consulta los archivos vinculados a los expedientes estudiantiles.</p>
    </div>
    @if (User.PuedeCrearDocumentos())
    {
        <a class="btn btn-primary" asp-action="CrearDocumento">+ Nuevo documento</a>
    }
</div>

<form class="search-panel" asp-action="ObtenerDocumentos" method="get">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="tipoDocumentoId">Tipo de documento</label>
            <select class="form-select" id="tipoDocumentoId" name="tipoDocumentoId"
                    asp-items="@(ViewBag.TiposDocumentoFiltro as SelectList)">
                <option value="">Todos los tipos</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="idEstado">Estado</label>
            <select class="form-select" id="idEstado" name="idEstado"
                    asp-items="@(ViewBag.EstadosFiltro as SelectList)">
                <option value="">Todos los estados</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="fecha">Fecha de subida</label>
            <input class="form-control" id="fecha" name="fecha" type="date"
                   value="@(filtro.Fecha?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-2">
            <div class="d-grid gap-2 d-sm-flex d-md-grid">
                <button class="btn btn-outline-primary flex-fill" type="submit">Filtrar</button>
                <a class="btn btn-outline-secondary flex-fill" asp-action="ObtenerDocumentos">Limpiar</a>
            </div>
        </div>
    </div>
</form>

<div class="surface-card overflow-hidden">
    @if (Model.Registros.Any())
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Documento</th>
                        <th>Identificación estudiante</th>
                        <th>Tipo</th>
                        <th>Consecutivo</th>
                        <th>Fecha de subida</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var documento in Model.Registros)
                    {
                        <tr>
                            <td><strong>#@documento.IdDocumento</strong></td>
                            <td>@documento.IdentificacionEstudiante</td>
                            <td><span class="type-badge">@documento.TipoDocumento</span></td>
                            <td>@documento.Consecutivo</td>
                            <td class="text-nowrap">@documento.FechaSubida.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="status-badge @(documento.Estado == "Activo" ? "status-active" : "status-inactive")">@documento.Estado</span>
                            </td>
                            <td>
                                <div class="table-actions justify-content-end">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="DetallesDocumento" asp-route-id="@documento.IdDocumento">Ver</a>
                                    <a class="btn btn-sm btn-outline-primary" asp-action="DescargarDocumento" asp-route-id="@documento.IdDocumento">Descargar</a>
                                    @if (User.PuedeModificarDocumentos())
                                    {
                                        <a class="btn btn-sm btn-outline-secondary" asp-action="EditarDocumento" asp-route-id="@documento.IdDocumento">Editar</a>
                                    }
                                    @if (User.PuedeEliminarDocumentos())
                                    {
                                        <a class="btn btn-sm btn-outline-danger" asp-action="EliminarDocumento" asp-route-id="@documento.IdDocumento">Eliminar</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">PDF</div>
            <h2>No hay documentos registrados</h2>
            <p class="mb-0">Prueba con otros filtros o registra un nuevo documento.</p>
        </div>
    }
</div>

@if (Model.TotalRegistros > 0)
{
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mt-3">
        <p class="text-muted mb-0">Mostrando @primerRegistro-@ultimoRegistro de @Model.TotalRegistros documentos</p>

        @if (Model.TotalPaginas > 1)
        {
            <nav aria-label="Paginación de documentos">
                <ul class="pagination mb-0">
                    <li class="page-item @(!Model.TienePaginaAnterior ? "disabled" : string.Empty)">
                        <a class="page-link" asp-action="ObtenerDocumentos"
                           asp-route-tipoDocumentoId="@filtro.TipoDocumentoId"
                           asp-route-idEstado="@filtro.IdEstado"
                           asp-route-fecha="@(filtro.Fecha?.ToString("yyyy-MM-dd"))"
                           asp-route-pagina="@(Model.PaginaActual - 1)">Anterior</a>
                    </li>

                    @for (int pagina = paginaInicial; pagina <= paginaFinal; pagina++)
                    {
                        <li class="page-item @(pagina == Model.PaginaActual ? "active" : string.Empty)">
                            <a class="page-link" asp-action="ObtenerDocumentos"
                               asp-route-tipoDocumentoId="@filtro.TipoDocumentoId"
                               asp-route-idEstado="@filtro.IdEstado"
                               asp-route-fecha="@(filtro.Fecha?.ToString("yyyy-MM-dd"))"
                               asp-route-pagina="@pagina">@pagina</a>
                        </li>
                    }

                    <li class="page-item @(!Model.TienePaginaSiguiente ? "disabled" : string.Empty)">
                        <a class="page-link" asp-action="ObtenerDocumentos"
                           asp-route-tipoDocumentoId="@filtro.TipoDocumentoId"
                           asp-route-idEstado="@filtro.IdEstado"
                           asp-route-fecha="@(filtro.Fecha?.ToString("yyyy-MM-dd"))"
                           asp-route-pagina="@(Model.PaginaActual + 1)">Siguiente</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
