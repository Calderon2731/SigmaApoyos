@model SigmaApoyos.Application.DTOs.TiposAdecuacion.TipoAdecuacionDto
@{ ViewData["Title"] = "Eliminar tipo de adecuación"; }
<div class="page-header"><div><span class="page-eyebrow">Acción irreversible</span><h1 class="page-title">Eliminar tipo de adecuación</h1><p class="page-subtitle">Confirma que seleccionaste la opción correcta.</p></div></div>
<div class="surface-card danger-card overflow-hidden"><div class="danger-banner"><strong>¿Deseas eliminar este tipo de adecuación?</strong><p class="mb-0 mt-1 small">No será posible eliminarlo si está asociado a expedientes.</p></div><div class="detail-grid"><div class="detail-item"><span class="detail-label">ID</span><span class="detail-value">#@Model.IdTipoAdecuacion</span></div><div class="detail-item"><span class="detail-label">Nombre</span><span class="detail-value">@Model.Nombre</span></div></div>
<form class="card-body-comfort pt-3" asp-action="ConfirmarEliminarTipoAdecuacion" method="post"><input type="hidden" name="id" value="@Model.IdTipoAdecuacion" /><div class="form-actions"><button class="btn btn-danger" type="submit">Sí, eliminar</button><a class="btn btn-outline-secondary" asp-action="ObtenerTiposAdecuacion">Cancelar</a></div></form></div>
