@model SigmaApoyos.Application.DTOs.TiposAdecuacion.UpdateTipoAdecuacionDto
@{ ViewData["Title"] = "Editar tipo de adecuación"; }
<div class="page-header"><div><span class="page-eyebrow">Tipo #@Model.IdTipoAdecuacion</span><h1 class="page-title">Editar tipo de adecuación</h1><p class="page-subtitle">Actualiza el nombre de la opción seleccionada.</p></div></div>
<form asp-action="EditarTipoAdecuacion" method="post"><div class="surface-card"><div class="card-header-clean"><h2 class="h5 fw-bold mb-0">Información del tipo</h2></div><div class="card-body-comfort"><div asp-validation-summary="ModelOnly"></div><input asp-for="IdTipoAdecuacion" type="hidden" />
<div class="mb-4"><label class="form-label" asp-for="Nombre"></label><input class="form-control" asp-for="Nombre" /><span asp-validation-for="Nombre"></span></div><div class="form-actions"><button class="btn btn-primary" type="submit">Guardar cambios</button><a class="btn btn-outline-secondary" asp-action="ObtenerTiposAdecuacion">Cancelar</a></div></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
