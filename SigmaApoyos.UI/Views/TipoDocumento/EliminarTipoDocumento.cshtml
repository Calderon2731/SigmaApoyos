@model SigmaApoyos.Application.DTOs.TiposDocumento.TipoDocumentoDto
@{ ViewData["Title"] = "Eliminar tipo de documento"; }
<div class="page-header"><div><span class="page-eyebrow">Acción irreversible</span><h1 class="page-title">Eliminar tipo de documento</h1><p class="page-subtitle">Confirma que seleccionaste la opción correcta.</p></div></div>
<div class="surface-card danger-card overflow-hidden"><div class="danger-banner"><strong>¿Deseas eliminar este tipo de documento?</strong><p class="mb-0 mt-1 small">No será posible eliminarlo si está asociado a documentos.</p></div><div class="detail-grid"><div class="detail-item"><span class="detail-label">ID</span><span class="detail-value">#@Model.IdTipoDocumento</span></div><div class="detail-item"><span class="detail-label">Tipo</span><span class="detail-value">@Model.Tipo</span></div></div>
<form class="card-body-comfort pt-3" asp-action="ConfirmarEliminarTipoDocumento" method="post"><input type="hidden" name="id" value="@Model.IdTipoDocumento" /><div class="form-actions"><button class="btn btn-danger" type="submit">Sí, eliminar</button><a class="btn btn-outline-secondary" asp-action="ObtenerTiposDocumento">Cancelar</a></div></form></div>
