@model IEnumerable<SigmaApoyos.Application.DTOs.TiposDocumento.TipoDocumentoDto>
@{ ViewData["Title"] = "Tipos de documento"; }
<div class="page-header"><div><span class="page-eyebrow">Catálogos</span><h1 class="page-title">Tipos de documento</h1><p class="page-subtitle">Administra las clases de archivo disponibles.</p></div><a class="btn btn-primary" asp-action="CrearTipoDocumento">+ Nuevo tipo</a></div>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success"><strong>@success</strong></div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger"><strong>@error</strong></div> }
<div class="surface-card overflow-hidden">
    @if (Model.Any()) { <div class="table-responsive"><table class="table"><thead><tr><th>ID</th><th>Tipo de documento</th><th class="text-end">Acciones</th></tr></thead><tbody>
    @foreach (var tipo in Model) { <tr><td><strong>#@tipo.IdTipoDocumento</strong></td><td>@tipo.Tipo</td><td><div class="table-actions justify-content-end"><a class="btn btn-sm btn-outline-secondary" asp-action="EditarTipoDocumento" asp-route-id="@tipo.IdTipoDocumento">Editar</a><a class="btn btn-sm btn-outline-danger" asp-action="EliminarTipoDocumento" asp-route-id="@tipo.IdTipoDocumento">Eliminar</a></div></td></tr> }
    </tbody></table></div> } else { <div class="empty-state"><div class="empty-icon">TD</div><h2>No hay tipos de documento</h2><p class="mb-0">Crea el primer tipo del catálogo.</p></div> }
</div>
