@using Microsoft.AspNetCore.Mvc.Rendering
@using SigmaApoyos.Application.DTOs.Comunes
@using SigmaApoyos.Application.DTOs.Usuarios
@model ResultadoPaginadoDto<UsuarioDto>

@{
    ViewData["Title"] = "Usuarios";
    var filtro = ViewBag.Filtro as FiltroUsuarioDto ?? new FiltroUsuarioDto();
    const int registrosPorPagina = 10;
    int primerRegistro = Model.TotalRegistros == 0 ? 0 : ((Model.PaginaActual - 1) * registrosPorPagina) + 1;
    int ultimoRegistro = Math.Min(Model.PaginaActual * registrosPorPagina, Model.TotalRegistros);
    int paginaInicial = Math.Max(1, Model.PaginaActual - 2);
    int paginaFinal = Math.Min(Model.TotalPaginas, Model.PaginaActual + 2);
}

<div class="page-header">
    <div>
        <span class="page-eyebrow">Administración</span>
        <h1 class="page-title">Usuarios</h1>
        <p class="page-subtitle">Gestiona las cuentas, roles y accesos al sistema.</p>
    </div>
    <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Register">+ Crear usuario</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success d-flex align-items-center mb-3" role="alert">
        <strong>@successMessage</strong>
    </div>
}

<form class="search-panel" asp-action="ObtenerUsuarios" method="get">
    <div class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label" for="nombre">Nombre</label>
            <div class="search-input">
                <span class="search-glyph" aria-hidden="true">⌕</span>
                <input class="form-control" id="nombre" name="nombre" value="@filtro.Nombre"
                       placeholder="Nombre o apellidos del usuario" />
            </div>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="idEstado">Estado</label>
            <select class="form-select" id="idEstado" name="idEstado"
                    asp-items="@(ViewBag.EstadosFiltro as SelectList)">
                <option value="">Todos los estados</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="rol">Rol</label>
            <select class="form-select" id="rol" name="rol"
                    asp-items="@(ViewBag.RolesFiltro as SelectList)">
                <option value="">Todos los roles</option>
            </select>
        </div>
        <div class="col-md-2">
            <div class="d-grid gap-2 d-sm-flex d-md-grid">
                <button class="btn btn-outline-primary flex-fill" type="submit">Filtrar</button>
                <a class="btn btn-outline-secondary flex-fill" asp-action="ObtenerUsuarios">Limpiar</a>
            </div>
        </div>
    </div>
</form>

<div class="surface-card overflow-hidden">
    @if (Model.Registros.Any())
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Correo electrónico</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th>Fecha de creación</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model.Registros)
                    {
                        string inicial = string.IsNullOrWhiteSpace(usuario.NombreCompleto)
                            ? "U"
                            : usuario.NombreCompleto[0].ToString().ToUpperInvariant();
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="user-avatar bg-light border">@inicial</span>
                                    <strong class="text-nowrap">@usuario.NombreCompleto</strong>
                                </div>
                            </td>
                            <td>@usuario.Email</td>
                            <td><span class="type-badge">@usuario.Rol</span></td>
                            <td>
                                <span class="status-badge @(usuario.Estado == "Activo" ? "status-active" : "status-inactive")">@usuario.Estado</span>
                            </td>
                            <td class="text-nowrap">@usuario.FechaCreacion.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="EditarUsuario" asp-route-id="@usuario.Id">Editar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">US</div>
            <h2>No hay usuarios para mostrar</h2>
            <p class="mb-0">Prueba con otros filtros o crea una nueva cuenta.</p>
        </div>
    }
</div>

@if (Model.TotalRegistros > 0)
{
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mt-3">
        <p class="text-muted mb-0">Mostrando @primerRegistro-@ultimoRegistro de @Model.TotalRegistros usuarios</p>

        @if (Model.TotalPaginas > 1)
        {
            <nav aria-label="Paginación de usuarios">
                <ul class="pagination mb-0">
                    <li class="page-item @(!Model.TienePaginaAnterior ? "disabled" : string.Empty)">
                        <a class="page-link" asp-action="ObtenerUsuarios"
                           asp-route-nombre="@filtro.Nombre"
                           asp-route-idEstado="@filtro.IdEstado"
                           asp-route-rol="@filtro.Rol"
                           asp-route-pagina="@(Model.PaginaActual - 1)">Anterior</a>
                    </li>

                    @for (int pagina = paginaInicial; pagina <= paginaFinal; pagina++)
                    {
                        <li class="page-item @(pagina == Model.PaginaActual ? "active" : string.Empty)">
                            <a class="page-link" asp-action="ObtenerUsuarios"
                               asp-route-nombre="@filtro.Nombre"
                               asp-route-idEstado="@filtro.IdEstado"
                               asp-route-rol="@filtro.Rol"
                               asp-route-pagina="@pagina">@pagina</a>
                        </li>
                    }

                    <li class="page-item @(!Model.TienePaginaSiguiente ? "disabled" : string.Empty)">
                        <a class="page-link" asp-action="ObtenerUsuarios"
                           asp-route-nombre="@filtro.Nombre"
                           asp-route-idEstado="@filtro.IdEstado"
                           asp-route-rol="@filtro.Rol"
                           asp-route-pagina="@(Model.PaginaActual + 1)">Siguiente</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
