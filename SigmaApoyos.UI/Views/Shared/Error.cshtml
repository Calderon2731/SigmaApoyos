@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="surface-card empty-state mx-auto" style="max-width: 680px;">
    <div class="empty-icon">!</div>
    <span class="page-eyebrow">Algo no salió bien</span>
    <h1 class="page-title h2 mt-2">No pudimos procesar la solicitud</h1>
    <p>Intenta nuevamente. Si el problema continúa, comunícate con la persona administradora del sistema.</p>
    @if (Model.ShowRequestId)
    {
        <p class="form-hint">Código de referencia: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary mt-2" asp-controller="Home" asp-action="Index">Volver al inicio</a>
</div>
