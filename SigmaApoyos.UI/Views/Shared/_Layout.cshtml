<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sigma Apoyos</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SigmaApoyos.UI.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container-xl">
                <a class="navbar-brand d-flex align-items-center gap-3" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true">Σ</span>
                    <span>
                        <strong class="d-block">Sigma Apoyos</strong>
                        <small>Liceo de Calle Fallas</small>
                    </span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false"
                        aria-label="Mostrar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav mx-lg-auto align-items-lg-center gap-lg-1 py-3 py-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                               asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true && User.PuedeLeerExpedientes())
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Expediente" ? "active" : "")"
                                   asp-area="" asp-controller="Expediente" asp-action="ObtenerExpedientes">Expedientes</a>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true && User.PuedeLeerDocumentos())
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Documento" ? "active" : "")"
                                   asp-area="" asp-controller="Documento" asp-action="ObtenerDocumentos">Documentos</a>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true && User.PuedeGestionarUsuarios())
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Usuario" ? "active" : "")"
                                   asp-area="" asp-controller="Usuario" asp-action="ObtenerUsuarios">Usuarios</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(new[] { "Estado", "TipoAdecuacion", "TipoDocumento" }.Contains(ViewContext.RouteData.Values["controller"]?.ToString()) ? "active" : "")"
                                   href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Catálogos</a>
                                <ul class="dropdown-menu shadow border-0 mt-lg-2">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Estado" asp-action="ObtenerEstados">Estados</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="TipoAdecuacion" asp-action="ObtenerTiposAdecuacion">Tipos de adecuación</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="TipoDocumento" asp-action="ObtenerTiposDocumento">Tipos de documento</a></li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Auditoria" ? "active" : "")"
                                   asp-area="" asp-controller="Auditoria" asp-action="ObtenerAuditorias">Auditoría</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="app-main">
        <div class="container-xl">
            @RenderBody()
        </div>
    </main>

    <footer class="app-footer">
        <div class="container-xl d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <span>© 2026 Sigma Apoyos</span>
            <span>Sistema de gestión de adecuaciones estudiantiles</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
